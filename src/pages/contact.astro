---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUrl } from '../utils/nav';
---

<BaseLayout title="Contact" description="Get in touch">
  <main class="page-shell contact-shell">
    <section class="content-section contact-section">
      <div class="contact-grid">
        <div class="contact-copy">
          <p class="section-kicker">Contact</p>
          <h1>Have an idea? Let’s connect.</h1>
          <p class="lede">
            I’m eager to hear about your goals and discuss how research, strategy, or service design can help move your work forward.
          </p>
          <div class="contact-actions">
            <a class="primary-link" href="mailto:hello@example.com">Email me</a>
            <a class="secondary-link" href={getUrl('/projects')}>View projects</a>
          </div>
        </div>

        <div class="contact-panel">
          <h2>Let’s make something valuable.</h2>
          <p>
            Available for strategic advisory, research partnerships, and product or service design collaborations.
          </p>
          <ul class="contact-list">
            <li><span>Email</span><a href="mailto:hello@example.com">hello@example.com</a></li>
            <li><span>Focus</span><strong>Research, strategy, service design</strong></li>
            <li><span>Availability</span><strong>Open for new projects</strong></li>
          </ul>
        </div>
      </div>
    </section>

    <div class="about-panel-block what-i-bring-block">
      <div class="about-panel">
        <div class="panel-label">
          <span class="panel-mark">✦</span>
          <span>What I bring</span>
        </div>
        <div class="bring-list">
          <div class="bring-item">
            <h3>Curiosity with range</h3>
            <p>I'm comfortable entering an unfamiliar industry and getting genuinely interested in how it works.</p>
          </div>
          <div class="bring-item">
            <h3>Systems thinking</h3>
            <p>I look beyond individual experiences to understand the larger system shaping them.</p>
          </div>
          <div class="bring-item">
            <h3>Research fluency</h3>
            <p>My work spans qualitative and quantitative research, and I'm comfortable figuring out what methodology a problem actually calls for.</p>
          </div>
          <div class="bring-item">
            <h3>Strategic structure</h3>
            <p>I enjoy creating frameworks, methodologies, and decision-making tools that turn ambiguity into something actionable.</p>
          </div>
          <div class="bring-item">
            <h3>A willingness to go deep</h3>
            <p>Give me a complicated subject and some time to investigate it, and I'll probably know considerably more about it than I did when we started.</p>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
