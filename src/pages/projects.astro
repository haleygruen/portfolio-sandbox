        <a class="project-row" href="/projects/centralized-back-office-blueprint">
          <span class="project-name">Centralized Back Office Blueprint</span>
          <span class="project-tags"><span>Service Design</span><span>Blueprinting</span><span>Ops</span></span>
        </a>
