---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUrl } from '../utils/nav';
---

<BaseLayout title="Home" description="Strategic portfolio and research practice">
  <main class="page-shell home-shell">
    <section class="hero-panel">
      <div class="hero-copy">
        <p class="eyebrow">Researcher • Strategist • Service Designer</p>
        <h1>Haley Gruensfelder.<br />Researcher and design strategist.</h1>
        <p class="lede">
          I create research programs and service experiences that turn unstructured complexity into decisions that teams can act on.
        </p>
        <div class="hero-links">
          <a href={getUrl('/projects')}>Projects</a>
          <a href={getUrl('/about')}>About</a>
          <a href="mailto:hello@example.com">Contact</a>
        </div>
      </div>
    </section>

    <section class="content-section services-section">
      <div class="section-label-wrap">
        <span class="section-mark">●</span>
        <p class="section-kicker">Services</p>
      </div>
      <div class="services-grid">
        <article class="service-card">
          <div class="service-topline">
            <span class="service-icon">✦</span>
            <h3>UX Research</h3>
          </div>
          <p>Mixed-method discovery and evaluation that surfaces customer truths, uncovering friction, unmet needs, and the signals that help teams prioritize well.</p>
        </article>
        <article class="service-card">
          <div class="service-topline">
            <span class="service-icon">✦</span>
            <h3>Strategy</h3>
          </div>
          <p>Translating evidence into product direction, strategic opportunities, and a clear path for decision-making across product, operations, and service teams.</p>
        </article>
        <article class="service-card">
          <div class="service-topline">
            <span class="service-icon">✦</span>
            <h3>Service Design</h3>
          </div>
          <p>I map the systems behind the experience, aligning people, processes, and touchpoints to reduce friction and improve service outcomes.</p>
        </article>
        <article class="service-card">
          <div class="service-topline">
            <span class="service-icon">✦</span>
            <h3>Workshops</h3>
          </div>
          <p>Facilitated alignment sessions that bring cross-functional groups together around insight, trade-offs, and decision frameworks.</p>
        </article>
        <article class="service-card">
          <div class="service-topline">
            <span class="service-icon">✦</span>
            <h3>Impact Tracking</h3>
          </div>
          <p>Designing scorecards, benchmark systems, and measurement frameworks that turn experience work into visible operational value.</p>
        </article>
      </div>
    </section>

    <section class="content-section projects-section">
      <div class="section-label-wrap">
        <span class="section-mark">●</span>
        <p class="section-kicker">Work</p>
      </div>
      <div class="project-list">
        <a class="project-row" href={getUrl('/projects/enterprise-journey-management-practice')}>
          <span class="project-name">Enterprise Journey Management</span>
          <span class="project-tags"><span>UX Research</span><span>Service Design</span><span>Strategy</span></span>
        </a>
        <a class="project-row" href={getUrl('/projects/usps-mail-kiosks-bid-discovery')}>
          <span class="project-name">USPS Mail Kiosks</span>
          <span class="project-tags"><span>Discovery</span><span>Evaluation</span><span>Bid Support</span></span>
        </a>
        <a class="project-row" href={getUrl('/projects/core-pos-benchmarking-longitudinal-audit')}>
          <span class="project-name">Core POS Benchmarking</span>
          <span class="project-tags"><span>Benchmarking</span><span>Metrics</span><span>UX</span></span>
        </a>
        <a class="project-row" href={getUrl('/projects/go-to-market-deal-making-process-overhaul')}>
          <span class="project-name">Go-To-Market Process Overhaul</span>
          <span class="project-tags"><span>Research</span><span>Ops</span><span>Strategy</span></span>
        </a>
        <a class="project-row" href={getUrl('/projects/legacy-supply-chain-product-modernization')}>
          <span class="project-name">Legacy Supply Chain Modernization</span>
          <span class="project-tags"><span>Product</span><span>Transformation</span><span>Research</span></span>
        </a>
      </div>
      <a class="all-link" href={getUrl('/projects')}>All case studies <span aria-hidden="true">→</span></a>
    </section>

    <section class="content-section journal-section">
      <div class="section-label-wrap">
        <span class="section-mark">●</span>
        <p class="section-kicker">Journal</p>
      </div>
      <div class="journal-list">
        <a class="journal-item" href={getUrl('/blog/portfolio-positioning')}>
          <span class="journal-date">Aug 29, 2026</span>
          <h3>Portfolio positioning and narrative clarity</h3>
        </a>
        <a class="journal-item" href={getUrl('/blog/research-methodology-reflection')}>
          <span class="journal-date">Aug 20, 2026</span>
          <h3>Research methodology reflections</h3>
        </a>
        <a class="journal-item" href={getUrl('/blog/portfolio-positioning')}>
          <span class="journal-date">Aug 12, 2026</span>
          <h3>How service ecosystems shape research quality</h3>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
