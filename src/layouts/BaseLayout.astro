---
import '../styles/global.css';
import { getUrl } from '../utils/nav';
const { title = 'Portfolio', description = 'Portfolio site' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="site-body">
    <div class="site-shell">
      <header class="topbar">
        <nav class="nav" aria-label="Main navigation">
          <a class="brand-mark" href={getUrl('/')} aria-label="Home">H</a>
          <div class="nav-spacer"></div>
          <div class="nav-links">
            <a href={getUrl('/')}>Home</a>
            <a href={getUrl('/projects')}>Projects</a>
            <a href={getUrl('/about')}>About</a>
            <a href={getUrl('/blog')}>Blog</a>
            <a href={getUrl('/contact')}>Contact</a>
          </div>
          <button class="nav-toggle" type="button" aria-label="Toggle menu">Menu</button>
        </nav>
      </header>
      <slot />
      <footer class="page-footer">
        <div class="cta-panel">
          <h2>Let’s create your next big idea.</h2>
          <a class="text-link" href={getUrl('/contact')}>Schedule a call <span aria-hidden="true">→</span></a>
        </div>
        <div class="footer-meta">
          <div class="footer-links">
            <a href={getUrl('/')}>Home</a>
            <a href={getUrl('/projects')}>Projects</a>
            <a href={getUrl('/about')}>About</a>
            <a href={getUrl('/blog')}>Blog</a>
            <a href={getUrl('/contact')}>Contact</a>
          </div>
          <div class="footer-utility">
            <a href={getUrl('/')}>Style guide</a>
            <a href={getUrl('/')}>Licenses</a>
            <a href={getUrl('/')}>Changelog</a>
          </div>
          <p>© 2026 Haley Gruensfelder</p>
        </div>
      </footer>
    </div>
  </body>
</html>
