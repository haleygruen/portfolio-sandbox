---
import '../styles/global.css';
const { title = 'Portfolio', description = 'Portfolio site' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="topbar">
        <nav class="nav" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
          <a href="/blog">Blog</a>
        </nav>
      </header>
      <slot />
      <footer class="footer">
        <p>© 2026 Portfolio Sandbox</p>
      </footer>
    </div>
  </body>
</html>
